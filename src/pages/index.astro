---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Shlomo Hecht — Professional Keyboardist">

  <!-- Mark hero as animated BEFORE paint so the initial state is hidden.
       If JS is disabled, this never runs and content shows normally. -->
  <script is:inline>
    document.documentElement.classList.add('hero-anim');
  </script>

  <!-- ░░ HERO ░░ -->
  <section class="hero">
    <div class="video-wrap">
      <video class="hero-vid active" autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback>
        <source src="/videos/event1.mp4" type="video/mp4" />
      </video>
      <video class="hero-vid" autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback>
        <source src="/videos/event2.mp4" type="video/mp4" />
      </video>
      <video class="hero-vid" autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback>
        <source src="/videos/event3.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Shlomo Hecht Productions</p>
      <h1>
        <span class="hero-line"><span class="hero-line-inner"><span class="hero-word">Music</span>&nbsp;<span class="hero-word">that</span></span></span>
        <span class="hero-line"><span class="hero-line-inner"><em><span class="hero-word">moves</span>&nbsp;<span class="hero-word">people</span></em></span></span>
      </h1>
      <p class="hero-tagline">
        Live keyboard performance for weddings, bar mitzvahs &amp; corporate events
      </p>
      <a href="/book" class="btn-gold hero-btn">
        <svg class="hero-btn-border" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="hero-btn-stroke" d="M 50 0 L 100 0 L 100 100 L 0 100 L 0 0 L 50 0" fill="none" stroke-width="1" stroke-linecap="square" stroke-linejoin="miter" vector-effect="non-scaling-stroke" stroke-dasharray="9999" stroke-dashoffset="9999" />
        </svg>
        <span class="hero-btn-label">Check Availability</span>
      </a>
    </div>
    <div class="scroll-line"><span></span></div>
  </section>

  <!-- ░░ INTRO ░░ -->
  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-text">
        <p class="section-label">About</p>
        <div class="intro-heading-row">
          <h2>Shlomo<br />Hecht</h2>
          <div class="intro-photo intro-photo-inline">
            <img src="/shlomo-profile.jpg" alt="Shlomo Hecht" />
          </div>
        </div>
        <div class="divider"></div>
        <p>
          With years of experience performing at simchas around the country,
          Shlomo brings his passion and musicality to every stage.
        </p>
        <div class="intro-photo intro-photo-block">
          <img src="/shlomo-profile.jpg" alt="Shlomo Hecht" />
        </div>
        <a href="/bio" class="btn-gold" style="margin:2.25rem auto 0;min-width:240px;text-align:center;display:block;width:fit-content">Read Full Bio</a>
      </div>
      <div class="intro-stats">
        <div class="stat">
          <span class="stat-num" data-count-to="100" data-suffix="+">0</span>
          <span class="stat-label">Events Performed</span>
        </div>
        <div class="stat">
          <span class="stat-num" data-count-to="5" data-suffix="+">0</span>
          <span class="stat-label">Years Experience</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ WHATSAPP ░░ -->
  <section class="wa-section">
    <div class="container wa-grid">
      <div class="wa-text">
        <p class="section-label">Contact</p>
        <h2>Let's talk about<br />your event</h2>
        <div class="divider"></div>
        <p>
          Have a question or want to discuss a custom performance?
          Reach out by WhatsApp for a quick response, or send an email for formal inquiries.
        </p>
      </div>
      <div class="contact-btns">
        <a
          href="https://wa.me/14084208118?text=Hi%20Shlomo%2C%20I%27d%20like%20to%20inquire%20about%20booking%20you%20for%20an%20event."
          target="_blank"
          rel="noopener noreferrer"
          class="wa-btn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.528 5.845L0 24l6.34-1.508A11.955 11.955 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.372l-.36-.213-3.727.887.885-3.635-.234-.373A9.818 9.818 0 1112 21.818zm5.472-7.436c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
          WhatsApp
        </a>
        <a href="mailto:shlomohechtmusic@gmail.com" class="email-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
          Email
        </a>
      </div>
    </div>
  </section>

  <!-- ░░ BOOK CTA ░░ -->
  <section class="book-cta">
    <div class="container book-cta-inner">
      <p class="section-label">Availability</p>
      <h2>Ready to book?</h2>
      <p>View real-time availability and reserve your date.</p>
      <a href="/book" class="btn-gold" style="margin-top:2rem">View Calendar &amp; Book</a>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ─────────────────────────────── */
  .hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    min-height: 460px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  @media (min-width: 720px) {
    .hero {
      height: 100vh;
      height: 100dvh;
      margin-top: 0;
      min-height: 620px;
    }
  }

  .video-wrap {
    position: absolute;
    inset: 0;
    background: #000;
  }

  .hero-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease;
    pointer-events: none;
  }
  .hero-vid.active { opacity: 1; }

  /* Hide iOS Safari's native play button overlay when autoplay is blocked */
  .hero-vid::-webkit-media-controls,
  .hero-vid::-webkit-media-controls-start-playback-button,
  .hero-vid::-webkit-media-controls-panel,
  .hero-vid::-webkit-media-controls-overlay-play-button {
    display: none !important;
    -webkit-appearance: none;
    opacity: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom,
        rgba(0,0,0,0.25) 0%,
        rgba(0,0,0,0.5)  50%,
        rgba(10,10,10,1) 100%
      );
  }
  .video-wrap { pointer-events: none; }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  /* Mobile-only hero layout:
     - Flex column starting just below the SHP logo.
     - Auto margins above & below the eyebrow center it in the gap
       between the logo and the h1.
     - Auto margin above the button pushes it down near the scroll-line. */
  @media (max-width: 719px) {
    .hero {
      align-items: stretch;
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      height: 100%;
      padding-top: clamp(180px, 31dvh, 280px);
      padding-bottom: 5.5rem;
    }
    .hero-eyebrow {
      margin: auto 0;
    }
    .hero-content h1 {
      margin-bottom: 1.25rem;
    }
    .hero-tagline {
      margin-bottom: 0;
    }
    .hero-content .btn-gold {
      margin-top: auto;
    }
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 10vw, 8.5rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 0.92;
    margin-bottom: 1.5rem;
    color: var(--text);
  }
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }
  .hero-line-inner {
    display: inline-block;
    will-change: transform, opacity;
  }
  .hero-word {
    display: inline-block;
    will-change: transform, opacity;
  }

  /* Hide hero pieces before GSAP runs (only when JS-anim class is set
     by inline script so no-JS users still see the content). */
  html.hero-anim .hero-line-inner {
    opacity: 0;
  }
  html.hero-anim .hero-btn { opacity: 0; }
  html.hero-anim .hero-btn-label { opacity: 0; }
  html.hero-anim .scroll-line { opacity: 0; }

  /* Hero CTA: border is drawn by SVG path so we hide the native border. */
  .hero-content .btn-gold {
    border-color: transparent;
    overflow: visible;
  }
  .hero-btn-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .hero-btn-stroke {
    stroke: var(--gold);
  }
  .hero-btn-label {
    position: relative;
    z-index: 1;
    display: inline-block;
  }

  .hero-tagline {
    font-size: 0.9rem;
    color: rgba(240, 237, 232, 0.6);
    max-width: 400px;
    margin: 0 auto 2.75rem;
    letter-spacing: 0.04em;
    line-height: 1.8;
  }

  .scroll-line {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }
  .scroll-line span {
    display: block;
    width: 1px;
    height: 55px;
    background: linear-gradient(to bottom, transparent, var(--gold));
    animation: scrollDrop 2.2s ease infinite;
  }
  @keyframes scrollDrop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 0; }
    30%  { opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── INTRO (mobile-first) ───────────────── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .intro-text h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .intro-text h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .intro-heading-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .intro-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Inline circular photo: hidden on mobile, visible next to heading on desktop */
  .intro-photo-inline {
    display: none;
    width: clamp(100px, 22vw, 140px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 3px solid var(--gold);
    box-shadow: 0 0 0 6px rgba(200,169,110,0.15);
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Wide rectangular photo block: shown on mobile below the description */
  .intro-photo-block {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: 1.75rem;
    border: 1px solid var(--gold);
    box-shadow: 0 0 0 6px rgba(200,169,110,0.12);
    overflow: hidden;
  }
  .intro-photo-block img { object-position: center 22%; }

  @media (min-width: 720px) {
    .intro-heading-row { gap: 2rem; }
    .intro-photo-inline { display: block; width: 150px; }
    .intro-photo-block { display: none; }
  }

  .intro-stats {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-evenly;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .stat-num {
    display: block;
    font-family: 'Domine', serif;
    font-size: 2.75rem;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .stat-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 820px) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      padding-left: 0;
      padding-right: 0;
    }
    .intro-stats {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 2.75rem;
      padding-top: 0;
      padding-left: 4rem;
      border-top: none;
      border-left: 1px solid var(--border);
    }
    .stat-num { font-size: 3.5rem; }
  }

  /* ── WHATSAPP (mobile-first) ─────────────── */
  .wa-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .wa-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
  }
  .wa-text h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }
  .wa-text .divider { margin: 1.5rem auto; }
  .wa-text p { max-width: 100%; }

  .contact-btns {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: stretch;
    width: 100%;
  }

  .wa-btn,
  .email-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 2.5rem;
    border: 1px solid var(--gold);
    color: var(--gold);
    background: transparent;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.25s, color 0.25s, transform 0.2s;
  }
  @media (hover: hover) {
    .wa-btn:hover,
    .email-btn:hover {
      background: var(--gold);
      color: var(--bg);
      transform: translateY(-2px);
    }
  }

  @media (min-width: 820px) {
    .wa-grid {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 4rem;
      text-align: left;
    }
    .wa-text .divider { margin: 1.5rem 0; }
    .wa-text p { max-width: 420px; }
    .contact-btns {
      flex-direction: row;
      flex-shrink: 0;
      gap: 1rem;
      width: auto;
      align-items: center;
    }
    .wa-btn,
    .email-btn {
      padding: 0.95rem 2.75rem;
    }
  }

  /* ── BOOK CTA ─────────────────────────── */
  .book-cta { text-align: center; }
  .book-cta-inner { display: flex; flex-direction: column; align-items: center; }
  .book-cta h2 { font-size: clamp(2.2rem, 5vw, 4rem); color: var(--text); }
  .book-cta p { max-width: 420px; }
</style>

<script>
  // ── HERO ENTRANCE ANIMATION (GSAP) ─────────────────────
  import { gsap } from 'gsap';

  const lines = document.querySelectorAll<HTMLElement>('.hero-line-inner');
  const btn = document.querySelector<HTMLElement>('.hero-btn');
  const btnPath = document.querySelector<SVGPathElement>('.hero-btn-stroke');
  const btnLabel = document.querySelector<HTMLElement>('.hero-btn-label');
  const scrollLine = document.querySelector<HTMLElement>('.scroll-line');

  const runAnim = () => {
    const words = Array.from(document.querySelectorAll<HTMLElement>('.hero-word'));

    if (words.length < 4) return;

    // Allow lines to overflow while words scale during the pop.
    lines.forEach((line) => {
      if (line.parentElement) {
        gsap.set(line.parentElement, { overflow: 'visible' });
      }
    });

    gsap.set(words, {
      opacity: 0,
      scale: 0.35,
      transformOrigin: 'center center',
    });
    // Compute the rendered button perimeter (in CSS pixels). With
    // vector-effect="non-scaling-stroke" the dasharray is measured in
    // CSS pixels, not viewBox units, so pathLength normalization is unreliable.
    const btnRect = btn?.getBoundingClientRect();
    const perimeter = btnRect ? 2 * (btnRect.width + btnRect.height) : 600;
    gsap.set(btn, { opacity: 0 });
    gsap.set(btnPath, {
      strokeDasharray: perimeter,
      strokeDashoffset: perimeter,
    });
    gsap.set(btnLabel, {
      opacity: 0,
      scale: 0.35,
      transformOrigin: 'center center',
    });
    gsap.set(scrollLine, { opacity: 0 });
    document.documentElement.classList.remove('hero-anim');

    const wordStart = 0.35;
    const wordStagger = 0.36;
    const lastWordTime = wordStart + wordStagger * (words.length - 1);

    const tl = gsap.timeline();
    tl.to(words, {
        opacity: 1,
        scale: 1,
        duration: 1.3,
        ease: 'elastic.out(1.1, 0.5)',
        stagger: wordStagger,
      }, wordStart)
      .set(btn, { opacity: 1 }, lastWordTime + 1.4)
      .to(btnPath, { strokeDashoffset: 0, duration: 1.0, ease: 'power2.inOut' }, lastWordTime + 1.4)
      .to(btnLabel, {
        opacity: 1,
        scale: 1,
        duration: 1.3,
        ease: 'elastic.out(1.1, 0.5)',
      }, lastWordTime + 2.4)
      .to(scrollLine, {
        opacity: 1,
        duration: 0.6,
        ease: 'power2.out',
      }, lastWordTime + 3.7)
      // After a pause, fade out the headline words — only the nav logo, button,
      // eyebrow, tagline (and video) remain.
      .to(words, {
        opacity: 0,
        duration: 1.1,
        ease: 'power2.inOut',
        stagger: 0.08,
      }, lastWordTime + 4.6);
  };

  // Start as soon as the DOM is parsed — don't wait for fonts so the
  // animation begins immediately on slow networks.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAnim, { once: true });
  } else {
    runAnim();
  }

  const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('.hero-vid'));

  // Try to start playback on all videos (iOS Low Power Mode blocks autoplay)
  vids.forEach((v) => {
    v.muted = true;
    const attempt = () => v.play().catch(() => {});
    attempt();
    document.addEventListener('visibilitychange', attempt, { once: true });
  });

  if (vids.length > 1) {
    let idx = 0;
    setInterval(() => {
      vids[idx].classList.remove('active');
      idx = (idx + 1) % vids.length;
      vids[idx].classList.add('active');
    }, 8000);
  }

  // Count-up animation for stats when they scroll into view
  const statNums = document.querySelectorAll<HTMLElement>('.stat-num[data-count-to]');
  const totalDuration = (() => {
    let max = 0;
    statNums.forEach((el) => {
      const t = parseInt(el.dataset.countTo || '0', 10);
      if (t > max) max = t;
    });
    return max * 35;
  })();
  const animateCount = (el: HTMLElement, startTime: number) => {
    const target = parseInt(el.dataset.countTo || '0', 10);
    const suffix = el.dataset.suffix || '';
    const frame = (now: number) => {
      const progress = Math.min(1, (now - startTime) / totalDuration);
      const current = Math.floor(progress * target);
      if (progress >= 1) {
        el.textContent = target + suffix;
      } else {
        el.textContent = String(current);
        requestAnimationFrame(frame);
      }
    };
    requestAnimationFrame(frame);
  };
  const statsContainer = document.querySelector<HTMLElement>('.intro-stats');
  if (statsContainer) {
    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const startTime = performance.now();
          statNums.forEach((el) => animateCount(el, startTime));
          statObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    statObserver.observe(statsContainer);
  }
</script>
